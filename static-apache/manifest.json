{
    "name": "Static Website (via Apache)",
    "code": "apache",
    "type": "static",
    "version": "2.4",
    "description": "Apache HTTP Server serving static HTML/CSS/JS sites",
    "category": "static",
    "min_plan": "starter",
    "runtime": "static",
    "web_server": "apache",
    "multihost": {
        "server": "apache",
        "web_root": "/usr/local/apache2/htdocs",
        "sites_root": "/var/www/sites",
        "config_dir": "/usr/local/apache2/conf/insula/sites.d",
        "common_include": "/usr/local/apache2/conf/insula/site-common.conf",
        "listen": 80,
        "validate": [
            "/usr/local/apache2/bin/httpd",
            "-t"
        ],
        "reload": [
            "/usr/local/apache2/bin/apachectl",
            "graceful"
        ]
    },
    "image": null,
    "has_dockerfile": true,
    "deployment_strategy": "deployment",
    "components": [
        {
            "name": "static-apache",
            "type": "deployment",
            "image": "ghcr.io/insulahq/application-catalog/static-apache:2.4",
            "ports": [
                {
                    "port": 80,
                    "protocol": "TCP",
                    "ingress": true
                }
            ]
        }
    ],
    "networking": {
        "ingress_ports": [
            {
                "port": 443,
                "protocol": "TCP",
                "tls": true,
                "description": "Web traffic"
            }
        ],
        "host_ports": [],
        "websocket": false
    },
    "volumes": [
        {
            "local_path": ".",
            "container_path": "/usr/local/apache2/htdocs",
            "description": "Static files"
        }
    ],
    "resources": {
        "minimum": {
            "cpu": "0.10",
            "memory": "64Mi"
        },
        "recommended": {
            "cpu": "0.10",
            "memory": "64Mi"
        }
    },
    "health_check": {
        "path": "/",
        "command": null,
        "port": 80,
        "initial_delay_seconds": 10,
        "period_seconds": 30
    },
    "parameters": [
        {
            "key": "APACHE_CONF_DIR",
            "label": "Custom Apache config folder",
            "type": "string",
            "default": "",
            "required": false,
            "advanced": true,
            "description": "Optional. Absolute path to a folder for your own *.conf files, e.g. /usr/local/apache2/htdocs/.apache-conf . When set, the folder is created (with a README) if missing, its *.conf are loaded into the main server config, and it is never web-served. Leave blank to use the default config."
        }
    ],
    "tags": [
        "static",
        "apache",
        "html"
    ],
    "env_vars": {
        "configurable": [
            "APACHE_CONF_DIR"
        ],
        "fixed": {}
    }
}
